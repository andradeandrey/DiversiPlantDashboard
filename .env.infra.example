# ============================================
# DiversiPlant — Variáveis de ambiente (infra)
# ============================================
# Copie este arquivo para .env e preencha os valores.

# --- PostgreSQL externo (obrigatório) ---
# O banco deve ter PostGIS 3.4+ habilitado.
# Extensões necessárias: postgis, postgis_raster
DB_HOST=db.exemplo.com
DB_PORT=5432
DB_USER=diversiplant
DB_PASSWORD=ALTERE_AQUI
DB_NAME=diversiplant

# --- Dashboard ---
# Porta HTTP exposta pelo container (o proxy reverso aponta para cá)
DASHBOARD_PORT=8001

# --- Volume de ecoregions (opcional) ---
# Caminho no host para os rasters de ecorregiões.
# Se não disponível, o sistema usa apenas PostGIS para lookup.
# ECOREGIONS_PATH=./data/ecoregions_raster
